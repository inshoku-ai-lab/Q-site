{
  "name": "q-site",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/add-vercel-crons.mjs && npm run search:build",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "node scripts/sync-notion.mjs",
    "fetch-ogp": "node scripts/fetch-ogp.mjs",
    "build:from-md": "node scripts/build-from-md.mjs",
    "search:build": "pagefind --site .vercel/output/static"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@notionhq/client": "^2.3.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@vercel/og": "~1.0.1",
    "astro": "^7.4.2",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.6.1",
    "pagefind": "^1.4.1",
    "postcss": "^8.5.31"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
