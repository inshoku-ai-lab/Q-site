---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import PriceDisplay from "../../components/PriceDisplay.astro";
import ContactForm from "../../components/ContactForm.astro";
import { createSupabaseAdminClient } from "../../lib/supabase/admin";
import { getSilverPriceData } from "../../lib/silverPrice";

// Free spot-price feed changes gradually enough that a 30-min edge cache is
// fine, and stale-while-revalidate means a feed outage still serves the last
// good render (up to 24h) instead of the fallback message in PriceDisplay.
Astro.response.headers.set("Cache-Control", "public, s-maxage=1800, stale-while-revalidate=86400");

const admin = createSupabaseAdminClient();
const priceData = await getSilverPriceData(admin);
---

<Layout
  title="銀の購入代行"
  description="1オンス銀貨の購入代行。現在価格を時価連動で表示。"
>
  <div class="max-w-prose mx-auto px-4 md:px-0 py-12 md:py-16">
    <h1 class="font-serif text-2xl md:text-3xl font-bold text-ink mb-4">銀の購入代行</h1>
    <p class="text-ink leading-relaxed mb-8">
      1オンス銀貨(デザインはランダム)の購入を代行しています。現在の価格は以下の通りです。
    </p>

    <PriceDisplay ok={priceData.ok} breakdown={priceData.ok ? priceData.breakdown : undefined} />

    <ol class="grid grid-cols-1 sm:grid-cols-4 gap-4 my-10 text-sm">
      {[
        "フォームを送信(お名前・メールアドレス・簡単なご希望)",
        "担当より折り返しご連絡(本名・お届け先などを確認)",
        "お見積り確定・お支払い方法のご案内",
        "ご入金確認後、発送",
      ].map((step, i) => (
        <li class="flex gap-3 sm:flex-col sm:gap-1.5">
          <span class="font-serif font-bold text-earth text-lg leading-none">{i + 1}</span>
          <span class="text-ink-muted leading-snug">{step}</span>
        </li>
      ))}
    </ol>

    <section class="border-t border-paper-300 pt-10">
      <h2 class="font-serif text-xl font-semibold text-ink mb-2">購入のお問い合わせ</h2>
      <p class="text-ink-muted text-sm leading-relaxed mb-6">
        本名やお届け先住所は、この時点では不要です。お名前(本名でなくて構いません)・メールアドレスと、分かる範囲でのご希望をお送りください。詳細は追ってメールでお伺いします。
      </p>
      <ContactForm
        source="silver"
        messageLabel="ご希望枚数・お届け先地域など"
        messageHelp="分かる範囲で構いません。ご不明な点はここにお書きください。"
        messagePlaceholder="例:2枚、東京都内 など"
        submitLabel="購入について問い合わせる"
        successMessage="送信しました。内容を確認の上、通常2〜3営業日以内に担当よりご連絡いたします。"
      />
    </section>
  </div>
</Layout>
