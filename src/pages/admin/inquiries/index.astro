---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireAdmin, logAdminAccess } from "../../../lib/admin";
import { formatDateShort } from "../../../lib/posts";

const auth = await requireAdmin(Astro.request, Astro.cookies);
if (!auth.ok) {
  return Astro.redirect("/");
}
await logAdminAccess(auth.admin, auth.email, "view_inquiries");

const { data } = await auth.admin
  .from("contact_messages")
  .select("id, name, email, message, status, created_at")
  .order("created_at", { ascending: false });
const inquiries = data ?? [];

// Stored values stay new/read/replied; the design labels them
// 未対応 (rust) / 対応中 (sumi) / 完了 (rule).
const STATUS_LABELS: Record<string, string> = { new: "未対応", read: "対応中", replied: "完了" };
const STATUS_STYLES: Record<string, string> = {
  new: "bg-rust text-paper-100",
  read: "bg-sumi text-paper-100",
  replied: "bg-rule text-ink",
};
const counts = {
  all: inquiries.length,
  new: inquiries.filter((i) => i.status === "new").length,
  read: inquiries.filter((i) => i.status === "read").length,
};
---

<AdminLayout title="お問い合わせ一覧" active="inquiries">
  <h1 class="sr-only">お問い合わせ一覧</h1>
  <div class="px-5 md:px-0 py-3 flex gap-1.5 border-b-[3px] border-sumi" role="group" aria-label="状態で絞り込む">
    <button type="button" class="inq-filter min-h-[40px] px-3 border border-sumi text-[12px] font-bold" data-filter="all" aria-pressed="true">すべて {counts.all}</button>
    <button type="button" class="inq-filter min-h-[40px] px-3 border border-sumi text-[12px] font-bold" data-filter="new" aria-pressed="false">未対応 {counts.new}</button>
    <button type="button" class="inq-filter min-h-[40px] px-3 border border-sumi text-[12px] font-bold" data-filter="read" aria-pressed="false">対応中 {counts.read}</button>
  </div>

  <div class="px-5 md:px-0">
    {inquiries.map((inq) => (
      <div class="py-3.5 border-b border-rule flex flex-col gap-1.5" data-inquiry-id={inq.id} data-status={inq.status}>
        <div class="flex justify-between items-center gap-2">
          <span class="text-[13px] font-bold min-w-0">
            {inq.name}
            <a href={`mailto:${inq.email}`} class="ml-2 font-normal text-[12px] text-ink-muted break-all">{inq.email}</a>
          </span>
          <span class={`status-badge shrink-0 px-2 py-[3px] text-[10px] font-bold ${STATUS_STYLES[inq.status] ?? ""}`}>
            {STATUS_LABELS[inq.status] ?? inq.status}
          </span>
        </div>
        <p class="text-[13px] leading-[1.7] text-ink-light whitespace-pre-wrap">{inq.message}</p>
        <div class="flex items-center justify-between gap-2 flex-wrap">
          <span class="font-mono text-[11px] text-ink-muted">{formatDateShort(inq.created_at)}</span>
          <span class="flex gap-1">
            {["new", "read", "replied"].map((s) => (
              <button
                type="button"
                class="status-btn min-h-[36px] px-2.5 border border-rule text-[11px] text-ink-light hover:border-sumi disabled:opacity-30"
                data-status={s}
                disabled={inq.status === s}
              >
                {STATUS_LABELS[s]}にする
              </button>
            ))}
          </span>
        </div>
      </div>
    ))}
    {inquiries.length === 0 && <p class="text-[13px] text-ink-muted py-8 text-center">お問い合わせはまだありません。</p>}
  </div>

  <style>
    .inq-filter[aria-pressed="true"] {
      background: #2a1f11;
      color: #f6efdc;
    }
  </style>

  <script>
    const STATUS_LABELS: Record<string, string> = { new: "未対応", read: "対応中", replied: "完了" };
    const STATUS_STYLES: Record<string, string> = {
      new: "bg-rust text-paper-100",
      read: "bg-sumi text-paper-100",
      replied: "bg-rule text-ink",
    };

    let activeFilter = "all";
    function applyFilter() {
      document.querySelectorAll<HTMLElement>("[data-inquiry-id]").forEach((card) => {
        card.hidden = activeFilter !== "all" && card.dataset.status !== activeFilter;
      });
      document.querySelectorAll<HTMLButtonElement>(".inq-filter").forEach((b) => {
        b.setAttribute("aria-pressed", String(b.dataset.filter === activeFilter));
      });
    }
    document.querySelectorAll<HTMLButtonElement>(".inq-filter").forEach((b) => {
      b.addEventListener("click", () => {
        activeFilter = b.dataset.filter ?? "all";
        applyFilter();
      });
    });

    document.querySelectorAll<HTMLElement>("[data-inquiry-id]").forEach((card) => {
      const id = card.dataset.inquiryId;
      const badge = card.querySelector(".status-badge") as HTMLElement;
      card.querySelectorAll<HTMLButtonElement>(".status-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const status = btn.dataset.status!;
          btn.disabled = true;
          const res = await fetch(`/api/admin/inquiries/${id}/status`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status }),
          });
          if (res.ok) {
            badge.textContent = STATUS_LABELS[status];
            badge.className = `status-badge shrink-0 px-2 py-[3px] text-[10px] font-bold ${STATUS_STYLES[status] ?? ""}`;
            card.dataset.status = status;
            card.querySelectorAll<HTMLButtonElement>(".status-btn").forEach((b) => {
              b.disabled = b.dataset.status === status;
            });
            applyFilter();
          } else {
            btn.disabled = false;
          }
        });
      });
    });
  </script>
</AdminLayout>
