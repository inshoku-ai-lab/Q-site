---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import { requireAdmin, logAdminAccess } from "../../../lib/admin";
import { formatDate } from "../../../lib/posts";

const auth = await requireAdmin(Astro.request, Astro.cookies);
if (!auth.ok) {
  return Astro.redirect("/");
}
await logAdminAccess(auth.admin, auth.email, "view_bug_reports");

const { data } = await auth.admin
  .from("bug_reports")
  .select("id, description, email, page_url, device_type, browser, os, status, resolution_note, created_at")
  .order("created_at", { ascending: false });
const reports = data ?? [];

const STATUS_LABELS: Record<string, string> = {
  new: "未対応",
  fixed: "修正済み",
  needs_review: "要確認",
  wontfix: "対応しない",
};
const STATUS_STYLES: Record<string, string> = {
  new: "bg-rust/10 text-rust",
  fixed: "bg-moss/10 text-moss-dark",
  needs_review: "bg-earth/10 text-earth",
  wontfix: "bg-paper-300 text-ink-muted",
};
const DEVICE_LABELS: Record<string, string> = { mobile: "スマホ", tablet: "タブレット", desktop: "PC" };
---

<Layout title="バグ報告一覧" description="旅路の証人 バグ報告一覧" noIndex>
  <div class="max-w-5xl mx-auto px-4 md:px-0 py-12">
    <div class="flex items-center justify-between mb-6">
      <h1 class="font-serif text-2xl font-semibold text-ink">バグ報告一覧({reports.length}件)</h1>
      <nav class="text-sm">
        <a href="/admin" class="text-earth hover:text-ink underline">ダッシュボードへ</a>
      </nav>
    </div>

    <div class="space-y-4">
      {reports.map((r) => (
        <div class="border border-paper-300 rounded-md p-4" data-report-id={r.id}>
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <div class="text-xs text-ink-muted flex flex-wrap gap-x-3">
              {r.page_url && (
                <a href={r.page_url} target="_blank" rel="noopener" class="text-earth hover:text-ink underline break-all">
                  {r.page_url}
                </a>
              )}
              {r.device_type && <span>{DEVICE_LABELS[r.device_type] ?? r.device_type}</span>}
              {r.browser && <span>{r.browser}</span>}
              {r.os && <span>{r.os}</span>}
              {r.email && <span>{r.email}</span>}
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <span class={`text-xs px-2 py-0.5 rounded-full status-badge ${STATUS_STYLES[r.status] ?? ""}`}>
                {STATUS_LABELS[r.status] ?? r.status}
              </span>
              <span class="text-xs text-ink-muted font-mono">{formatDate(r.created_at)}</span>
            </div>
          </div>
          <p class="text-sm text-ink whitespace-pre-wrap leading-relaxed mb-2">{r.description}</p>
          {r.resolution_note && (
            <p class="text-xs text-ink-muted bg-paper-50 border border-paper-200 rounded px-3 py-2 mb-3 whitespace-pre-wrap">
              {r.resolution_note}
            </p>
          )}
          <div class="flex gap-2">
            {["new", "fixed", "needs_review", "wontfix"].map((s) => (
              <button
                type="button"
                class="status-btn text-xs px-3 py-1 rounded-full border border-paper-300 text-ink-muted hover:border-moss hover:text-moss-dark disabled:opacity-30"
                data-status={s}
                disabled={r.status === s}
              >
                {STATUS_LABELS[s]}にする
              </button>
            ))}
          </div>
        </div>
      ))}
      {reports.length === 0 && <p class="text-sm text-ink-muted py-8 text-center">バグ報告はまだありません。</p>}
    </div>
  </div>

  <script>
    const STATUS_LABELS: Record<string, string> = {
      new: "未対応",
      fixed: "修正済み",
      needs_review: "要確認",
      wontfix: "対応しない",
    };
    const STATUS_STYLES: Record<string, string> = {
      new: "bg-rust/10 text-rust",
      fixed: "bg-moss/10 text-moss-dark",
      needs_review: "bg-earth/10 text-earth",
      wontfix: "bg-paper-300 text-ink-muted",
    };

    document.querySelectorAll<HTMLElement>("[data-report-id]").forEach((card) => {
      const id = card.dataset.reportId;
      const badge = card.querySelector(".status-badge") as HTMLElement;
      card.querySelectorAll<HTMLButtonElement>(".status-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const status = btn.dataset.status!;
          btn.disabled = true;
          const res = await fetch(`/api/admin/bug-reports/${id}/status`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status }),
          });
          if (res.ok) {
            badge.textContent = STATUS_LABELS[status];
            badge.className = `text-xs px-2 py-0.5 rounded-full status-badge ${STATUS_STYLES[status] ?? ""}`;
            card.querySelectorAll<HTMLButtonElement>(".status-btn").forEach((b) => {
              b.disabled = b.dataset.status === status;
            });
          } else {
            btn.disabled = false;
          }
        });
      });
    });
  </script>
</Layout>
