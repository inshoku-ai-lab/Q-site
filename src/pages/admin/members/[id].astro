---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import VHead from "../../../components/VHead.astro";
import { requireAdmin, logAdminAccess } from "../../../lib/admin";
import { formatDate } from "../../../lib/posts";

const auth = await requireAdmin(Astro.request, Astro.cookies);
if (!auth.ok) {
  const next = encodeURIComponent(Astro.url.pathname + Astro.url.search);
  return Astro.redirect(`/admin/login?next=${next}${auth.reason === "not_admin" ? "&error=not_admin" : ""}`);
}

const { id } = Astro.params;
const { data: member } = await auth.admin
  .from("members")
  .select("*")
  .eq("id", id)
  .maybeSingle();

if (!member) {
  return new Response("会員が見つかりません", { status: 404 });
}

await logAdminAccess(auth.admin, auth.email, `view_member:${member.id}`);

const PROVIDER_LABELS: Record<string, string> = { google: "Google", facebook: "Facebook", line: "LINE" };
function articleHref(slug: string): string {
  return slug.startsWith("/") ? slug : `/posts/${slug}/`;
}
const REASON_LABELS: Record<string, string> = {
  financial: "金銭的利益をもたらした",
  referral: "誰かに薦めたことがある",
  other: "その他の形で応援",
};
---

<AdminLayout title={`会員詳細: ${member.display_name || member.email}`} active="members">
  <div class="md:max-w-[760px]">
    <a href="/admin/members" class="inline-flex items-center min-h-[44px] px-5 md:px-0 text-[12px]">← 会員一覧</a>
    <VHead
      text={member.display_name || "名前なし"}
      mobile={{ size: 36, height: 200, padY: 16, padX: 12, tracking: 0.1 }}
      pc={{ size: 40, height: 220, padY: 20, padX: 14, tracking: 0.1 }}
      class="border-t-[3px] border-sumi"
      bodyClass="justify-end gap-2"
    >
      <span class="vhead-label">MEMBER</span>
      <span class="text-[13px] text-ink-light break-all">{member.email}</span>
      <span class="text-[12px] text-ink-muted">{formatDate(member.joined_at)} 入会</span>
    </VHead>

    <section class="px-5 md:px-0 pt-5">
      <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-2.5 min-h-[48px] items-center border-b border-rule text-[13px]">
        <span class="text-ink-muted">ログイン方法</span><span>{PROVIDER_LABELS[member.provider] ?? member.provider}</span>
      </div>
      <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-2.5 min-h-[48px] items-center border-b border-rule text-[13px]">
        <span class="text-ink-muted">同意理由</span><span>{REASON_LABELS[member.agreement_reason] ?? member.agreement_reason}</span>
      </div>
      <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-2.5 min-h-[48px] items-center border-b border-rule text-[13px]">
        <span class="text-ink-muted">入会日</span><span>{formatDate(member.joined_at)}</span>
      </div>
      <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-2.5 min-h-[48px] items-center border-b border-rule text-[13px]">
        <span class="text-ink-muted">流入元記事</span>
        <span class="break-all py-2">{member.referrer_article_slug ? <a href={articleHref(member.referrer_article_slug)}>{member.referrer_article_slug}</a> : "―"}</span>
      </div>
      <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-2.5 min-h-[48px] items-center border-b border-rule text-[13px]">
        <span class="text-ink-muted">最初に読んだ記事</span>
        <span class="break-all py-2">{member.first_read_article_slug ? <a href={articleHref(member.first_read_article_slug)}>{member.first_read_article_slug}</a> : "―"}</span>
      </div>
    </section>

    <section class="px-5 md:px-0 pt-6">
      <h2 class="sec-h !text-[17px]"><label for="admin-note">管理メモ</label></h2>
      <textarea
        id="admin-note"
        rows="5"
        class="field mt-3 !text-[15px] !leading-[1.8]"
        placeholder="このメンバーについてのメモ(例: ◯◯さんの紹介で入会)"
      >{member.admin_note ?? ""}</textarea>
      <button id="save-note-btn" type="button" class="btn btn-sumi w-full mt-2.5">メモを保存</button>
      <p id="save-note-status" class="text-[12px] text-ink-muted mt-2" role="status"></p>
    </section>
  </div>
</AdminLayout>

<script define:vars={{ memberId: member.id }}>
  const btn = document.getElementById("save-note-btn");
  const textarea = document.getElementById("admin-note");
  const status = document.getElementById("save-note-status");

  btn?.addEventListener("click", async () => {
    btn.setAttribute("disabled", "true");
    if (status) status.textContent = "保存中...";

    const res = await fetch(`/api/admin/members/${memberId}/note`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ note: textarea.value }),
    });

    btn.removeAttribute("disabled");
    if (status) status.textContent = res.ok ? "保存しました" : "保存に失敗しました";
  });
</script>
