---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireAdmin, logAdminAccess } from "../../../lib/admin";
import { formatDateShort } from "../../../lib/posts";

const auth = await requireAdmin(Astro.request, Astro.cookies);
if (!auth.ok) {
  return Astro.redirect("/");
}
await logAdminAccess(auth.admin, auth.email, "view_members");

const url = new URL(Astro.request.url);
const providerFilter = url.searchParams.get("provider") ?? "";
const reasonFilter = url.searchParams.get("reason") ?? "";
const fromFilter = url.searchParams.get("from") ?? "";
const toFilter = url.searchParams.get("to") ?? "";
const q = url.searchParams.get("q") ?? "";

let query = auth.admin
  .from("members")
  .select("id, email, display_name, provider, agreement_reason, joined_at, admin_note")
  .order("joined_at", { ascending: false });

if (providerFilter) query = query.eq("provider", providerFilter);
if (reasonFilter) query = query.eq("agreement_reason", reasonFilter);
if (fromFilter) query = query.gte("joined_at", fromFilter);
if (toFilter) query = query.lte("joined_at", toFilter);

const { data } = await query;
let members = data ?? [];
if (q) {
  const needle = q.toLowerCase();
  members = members.filter(
    (m) => m.email?.toLowerCase().includes(needle) || m.display_name?.toLowerCase().includes(needle)
  );
}

const PROVIDER_LABELS: Record<string, string> = { google: "Google", facebook: "Facebook", line: "LINE" };
const REASON_LABELS: Record<string, string> = {
  financial: "金銭的利益",
  referral: "推薦",
  other: "その他応援",
};

const csvParams = new URLSearchParams(url.search);
const filtersActive = Boolean(providerFilter || reasonFilter || fromFilter || toFilter);
---

<AdminLayout title="会員一覧" active="members">
  <h1 class="sr-only">会員一覧</h1>
  <form method="get" class="px-5 md:px-0 py-4 border-b-[3px] border-sumi">
    <div class="flex gap-1.5">
      <label class="sr-only" for="member-q">メール・名前で検索</label>
      <input id="member-q" type="search" name="q" value={q} placeholder="メール・名前で検索" class="flex-1 min-w-0 h-11 px-3 border border-sumi bg-field text-[16px] md:text-[14px] rounded-none" />
      <button type="submit" class="h-11 px-3 border border-sumi text-[12px] font-bold hover:bg-moss/10">検索</button>
      <a href={`/api/admin/members.csv?${csvParams.toString()}`} class="h-11 flex items-center px-3 bg-sumi text-paper-100 hover:text-kraft text-[12px] font-bold">CSV</a>
    </div>
    <details class="mt-2" open={filtersActive}>
      <summary class="text-[12px] text-moss font-bold cursor-pointer min-h-[32px] flex items-center">絞り込み{filtersActive && "（適用中）"}</summary>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-1.5 pt-1 text-[13px]">
        <select name="provider" class="h-11 px-2 border border-sumi bg-field rounded-none">
          <option value="">ログイン方法（すべて）</option>
          <option value="google" selected={providerFilter === "google"}>Google</option>
          <option value="facebook" selected={providerFilter === "facebook"}>Facebook</option>
          <option value="line" selected={providerFilter === "line"}>LINE</option>
        </select>
        <select name="reason" class="h-11 px-2 border border-sumi bg-field rounded-none">
          <option value="">理由（すべて）</option>
          <option value="financial" selected={reasonFilter === "financial"}>金銭的利益</option>
          <option value="referral" selected={reasonFilter === "referral"}>推薦</option>
          <option value="other" selected={reasonFilter === "other"}>その他応援</option>
        </select>
        <label class="flex flex-col text-[11px] text-ink-muted">入会日（から）
          <input type="date" name="from" value={fromFilter} class="h-11 px-2 border border-sumi bg-field text-ink text-[13px] rounded-none" />
        </label>
        <label class="flex flex-col text-[11px] text-ink-muted">入会日（まで）
          <input type="date" name="to" value={toFilter} class="h-11 px-2 border border-sumi bg-field text-ink text-[13px] rounded-none" />
        </label>
      </div>
      <div class="flex gap-1.5 mt-2">
        <button type="submit" class="btn btn-sumi !min-h-[40px] !text-[13px]">絞り込む</button>
        <a href="/admin/members" class="btn btn-outline !min-h-[40px] !text-[13px]">リセット</a>
      </div>
    </details>
  </form>

  <div class="px-5 md:px-0 py-2.5 text-[12px] text-ink-muted">{members.length}人 · 入会日の新しい順</div>

  <div class="px-5 md:px-0">
    {
      members.map((m) => (
        <a href={`/admin/members/${m.id}`} class="grid grid-cols-[minmax(0,1fr)_auto] gap-2 py-3.5 border-b border-rule text-ink hover:text-ink hover:bg-moss/5">
          <span class="flex flex-col gap-1 min-w-0">
            <span class="text-[14px] font-bold">{m.display_name || "（名前なし）"}</span>
            <span class="text-[12px] text-ink-muted break-all">{m.email}</span>
            <span class="flex gap-1">
              <span class="px-1.5 py-0.5 border border-rule text-[10px]">{PROVIDER_LABELS[m.provider] ?? m.provider}</span>
              <span class="px-1.5 py-0.5 border border-rule text-[10px]">{REASON_LABELS[m.agreement_reason] ?? m.agreement_reason}</span>
            </span>
          </span>
          <span class="flex flex-col items-end gap-1">
            <span class="font-mono text-[11px] text-ink-muted">{formatDateShort(m.joined_at)}</span>
            {m.admin_note && <span class="text-[10px] text-moss font-bold">メモあり</span>}
          </span>
        </a>
      ))
    }
    {members.length === 0 && <p class="text-[13px] text-ink-muted py-8 text-center">該当する会員がいません。</p>}
  </div>
</AdminLayout>
