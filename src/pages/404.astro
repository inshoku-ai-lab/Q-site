---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import VHead from "../components/VHead.astro";
import PostRow from "../components/PostRow.astro";
import { getPostsBySeries, getPostBySlug, getLatestPosts } from "../lib/posts";
import type { Post } from "../lib/posts";

// A few good places to land instead: the start of 放浪記, the
// Devolution primer, and the newest post.
const picks = [
  getPostsBySeries("放浪記")[0],
  getPostBySlug("devolution-theory-an-introduction"),
  getLatestPosts(1)[0],
].filter((p, i, arr): p is Post => Boolean(p) && arr.findIndex((q) => q?.id === p?.id) === i);
---

<Layout title="404 - ページが見つかりません" noIndex>
  <div class="max-w-site mx-auto md:px-8 md:pb-14">
    <div class="md:max-w-[760px] md:mx-auto">
      <VHead
        text="道に迷いました"
        mobile={{ size: 52, height: 440, maxWidth: 160, padY: 22, padX: 14, tracking: 0.1, fixed: true }}
        pc={{ size: 60, height: 460, maxWidth: 200, padY: 28, padX: 18, tracking: 0.1, fixed: true }}
        bodyClass="justify-between gap-3.5 md:!p-7"
      >
        <span class="font-serif font-extrabold text-[72px] leading-none text-ink">404</span>
        <span class="vhead-desc">お探しのページは見つかりませんでした。旅の途中ではよくあることです。</span>
        <div class="flex flex-col gap-1.5">
          <a href="/" class="btn btn-sumi">ホームへ</a>
          <a href="/archive/" class="btn btn-outline">アーカイブへ</a>
        </div>
      </VHead>

      <section class="px-5 md:px-0 pt-6 pb-10">
        <h2 class="sec-h">代わりにこちらはいかが</h2>
        {picks.map((p) => <PostRow post={p} variant="cat" />)}
      </section>
    </div>
  </div>
</Layout>
