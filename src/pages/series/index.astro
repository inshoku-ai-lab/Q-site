---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import VHead from "../../components/VHead.astro";
import SeriesTile from "../../components/SeriesTile.astro";
import Sidebar from "../../components/Sidebar.astro";
import { getSeriesSorted, SERIES_DESCRIPTIONS } from "../../lib/seriesMeta";

const series = getSeriesSorted();
---

<Layout title="シリーズ一覧" description="クリプトラベラーの連載シリーズ一覧。">
  <div class="max-w-site mx-auto md:px-8 md:pb-14 md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-10 md:items-start">
    <div class="min-w-0">
      <VHead
        text="連載"
        mobile={{ size: 48, height: 220, padY: 18, padX: 14, tracking: 0.15 }}
        pc={{ size: 64, height: 280, padY: 28, padX: 20, tracking: 0.15 }}
        bodyClass="justify-end gap-2.5 md:!p-7"
      >
        <span class="vhead-label">SERIES · {series.length}本</span>
        <span class="vhead-desc">番号順に読み進める長編。まずは放浪記の第0話から。</span>
      </VHead>

      <div class="px-5 md:px-0 pt-2 pb-10 md:grid md:grid-cols-2 md:gap-3">
        {
          series.map((s) => (
            <div class="mt-3">
              <SeriesTile name={s.name} count={s.count} description={SERIES_DESCRIPTIONS[s.name] ?? `${s.count}本の記事`} size="lg" />
            </div>
          ))
        }
      </div>
    </div>

    <Sidebar series={false} latest={8} />
  </div>
</Layout>
