---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import VHead from "../components/VHead.astro";
import SeriesTile from "../components/SeriesTile.astro";
import PostRow from "../components/PostRow.astro";
import Sidebar from "../components/Sidebar.astro";
import { getPostBySlug, getLatestPosts, formatDateShort } from "../lib/posts";
import type { Post } from "../lib/posts";
import { getSeriesSorted, clip } from "../lib/seriesMeta";
import { getImageDimensions } from "../lib/imageDimensions";

// Curated homepage picks: one Devolution Theory intro, one Teal Swan piece,
// one Bitcoin/BSV piece.
const featuredSlugs = [
  "devolution-theory-an-introduction",
  "satanic-ritual-survivor-turned-genius-trauma-therapist-teal-swans-story",
  "the-inventor-of-bitcoin-is-dr-craig-wright-17-mathematical-proofs-alpha",
];
const featured = featuredSlugs.map((slug) => getPostBySlug(slug)).filter((p): p is Post => Boolean(p));
const [lead, ...others] = featured;
const ordinals = ["壱", "弐", "参", "肆", "伍"];

const leadTitle = lead ? lead.title.replace(/[「」]/g, "").replace(/\s+/g, "") : "";
const leadImage = lead?.cover ?? "/images/hero-wanderer.webp";
const leadDim = lead?.cover ? getImageDimensions(lead.cover) : null;

const seriesList = getSeriesSorted();
const latest = getLatestPosts(10);
---

<Layout title="Qryptraveller's Notes" header="masthead">
  <h1 class="sr-only">Qryptraveller's Notes — 旅と思索の記録</h1>
  <div class="max-w-site mx-auto md:px-8 md:pb-14 md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-10">
    <div>
      {
        lead && (
          <a href={`/posts/${lead.slug}/`} class="block text-ink hover:text-ink group">
            <VHead
              as="h2"
              text={leadTitle}
              lineHeight={1.15}
              mobile={{ size: 46, height: 380, maxWidth: 180, padY: 18, padX: 12, tracking: 0 }}
              pc={{ size: 60, height: 500, maxWidth: 300, padY: 28, padX: 18, tracking: 0 }}
              bodyClass="justify-between gap-3.5 md:justify-start md:gap-[18px] md:!p-7"
            >
              <span class="font-serif font-extrabold text-[13px] md:text-[15px] text-moss tracking-[0.2em]">特集　壱</span>
              <img
                src={leadImage}
                width={leadDim?.width}
                height={leadDim?.height}
                alt=""
                class="hidden md:block w-full aspect-[16/10] object-cover sepia-img"
              />
              <span class="text-[14px] md:text-[16px] leading-[1.9] text-ink-light group-hover:text-ink">
                {clip(lead.seo_description || lead.excerpt, 70)}
              </span>
              <span class="text-[11px] md:text-[12px] text-ink-muted">
                {lead.category}
                <br class="md:hidden" />
                <span class="hidden md:inline"> · </span>
                {formatDateShort(lead.date)} · 約{lead.reading_time}分
              </span>
            </VHead>
          </a>
        )
      }

      {
        others.map((p, i) => (
          <a href={`/posts/${p.slug}/`} class="grid grid-cols-[48px_minmax(0,1fr)] md:grid-cols-[56px_minmax(0,1fr)] border-b border-sumi text-ink hover:text-ink hover:bg-moss/5">
            <span class="[writing-mode:vertical-rl] flex items-center justify-center bg-sumi text-paper-100 font-serif font-extrabold text-[15px] md:text-[16px] tracking-[0.2em] py-3">
              特集{ordinals[i + 1]}
            </span>
            <span class="flex flex-col gap-1.5 md:gap-2 px-5 py-4 md:px-7 md:py-[22px]">
              <span class="font-serif font-extrabold text-[17px] md:text-[21px] leading-[1.5] md:leading-[1.45]">{p.title}</span>
              <span class="text-[11px] md:text-[12px] text-ink-muted">
                {p.category} · 約{p.reading_time}分
              </span>
            </span>
          </a>
        ))
      }

      <!-- Mobile: 連載 tiles + 最新の記事 (PC shows these in the sidebar) -->
      <section class="md:hidden px-5 pt-7 pb-2">
        <h2 class="sec-h">連載</h2>
        <div class="grid grid-cols-2 gap-2 pt-3">
          {seriesList.map((s) => <SeriesTile name={s.name} count={s.count} />)}
        </div>
      </section>

      <section class="md:hidden px-5 pt-6 pb-10">
        <h2 class="sec-h">最新の記事</h2>
        {latest.map((p) => <PostRow post={p} variant="date" />)}
        <a href="/archive/" class="flex items-center justify-end min-h-[48px] text-[13px] font-bold">すべての記事 →</a>
      </section>
    </div>

    <Sidebar latest={8}>
    </Sidebar>
  </div>
</Layout>
