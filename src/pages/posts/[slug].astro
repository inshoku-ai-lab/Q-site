---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import ArticleBody from "../../components/ArticleBody.astro";
import VHead from "../../components/VHead.astro";
import NextBlock from "../../components/NextBlock.astro";
import EpisodeList from "../../components/EpisodeList.astro";
import PostRow from "../../components/PostRow.astro";
import {
  getPublishedPosts,
  getSeriesNavigator,
  getRelatedPosts,
  formatDate,
  formatDateShort,
  splitMemberContent,
} from "../../lib/posts";
import { extractToc } from "../../lib/toc";
import { getImageDimensions } from "../../lib/imageDimensions";
import { displayTitle, episodeLabel } from "../../lib/verticalText";
import { seriesHref } from "../../lib/seriesMeta";

export async function getStaticPaths() {
  return getPublishedPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { prev, next } = getSeriesNavigator(post);
const related = post.series ? [] : getRelatedPosts(post, 5);
const description = post.seo_description || post.excerpt || `${post.category ?? "記事"} | ${post.title}`;
const { freeBlocks, hasMemberContent } = splitMemberContent(post.blocks);
const toc = extractToc(freeBlocks).filter((t) => t.level === 2);
const hasToc = toc.length > 2;
const ogImage = post.cover ?? `/og/${post.slug}.png`;
const publishedTime = post.date ? new Date(post.date).toISOString() : undefined;
const canonicalUrl = new URL(`/posts/${post.slug}/`, Astro.site ?? "https://qryptraveller.com").toString();
const absoluteOgImage = new URL(ogImage, Astro.site ?? "https://qryptraveller.com").toString();
const authorUrl = new URL("/about/", Astro.site ?? "https://qryptraveller.com").toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  ...(publishedTime && { datePublished: publishedTime, dateModified: publishedTime }),
  ...(description && { description }),
  image: [absoluteOgImage],
  author: { "@type": "Person", name: "Qryptraveller", url: authorUrl },
  publisher: { "@type": "Organization", name: "Qryptraveller's Notes", url: Astro.site?.toString() ?? "https://qryptraveller.com" },
  inLanguage: "ja",
  mainEntityOfPage: canonicalUrl,
};

const label = episodeLabel(post);
const vTitle = displayTitle(post.title, post.series);
const back = post.series
  ? { href: seriesHref(post.series), label: post.series }
  : post.category
    ? { href: `/category/${encodeURIComponent(post.category)}/`, label: post.category }
    : { href: "/", label: "トップ" };
const coverDim = post.cover ? getImageDimensions(post.cover) : null;
const minutes = post.reading_time > 0 ? `約${post.reading_time}分` : "";
const chars = post.char_count > 0 ? `${post.char_count.toLocaleString()}字` : "";
const metaTail = [minutes, chars].filter(Boolean).join(" · ");
const joinHref = `/join?ref=${encodeURIComponent(`/posts/${post.slug}/`)}`;
const nextLabel = next ? (episodeLabel(next).split("　")[1] ? `次話　${episodeLabel(next).split("　")[1]}` : "次の記事") : "";
const fontSizes = [
  { key: "s", px: 13, label: "小" },
  { key: "m", px: 16, label: "中" },
  { key: "l", px: 19, label: "大" },
];
---

<Layout
  title={post.title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={`${post.title} のサムネイル`}
  ogType="article"
  publishedTime={publishedTime}
  articleSection={post.category ?? undefined}
  structuredData={structuredData}
  header="none"
  readingBar
>
  <header id="article-header" slot="header" class="sticky top-0 z-30 bg-sumi text-paper-100">
    <div class="max-w-site mx-auto h-12 md:h-14 pl-5 pr-5 md:px-8 flex items-center justify-between gap-4">
      <a href={back.href} class="md:hidden text-[12px] text-rule hover:text-paper-100 min-h-[44px] inline-flex items-center">
        ← {back.label}
      </a>
      <a href="/" class="hidden md:inline font-serif font-extrabold text-[18px] text-paper-100 hover:text-paper-100">
        Qryptraveller's Notes
      </a>
      <div class="flex items-center gap-5">
        <span class="hidden md:inline text-[13px] text-rule">{label.replace("　", " · ")}</span>
        <span class="md:hidden font-mono text-[11px] text-kraft" data-read-pct-wrap>
          {hasMemberContent ? <span data-gated-label>会員限定</span> : null}
          <span data-read-pct class={hasMemberContent ? "hidden" : ""}>0</span><span class={hasMemberContent ? "hidden" : ""} data-read-pct-unit>%</span>
        </span>
        <button
          type="button"
          data-menu-open
          class="hidden md:inline-flex items-center min-h-[44px] text-[13px] font-bold text-paper-100 hover:text-kraft"
          aria-expanded="false"
          aria-controls="site-menu"
        >
          メニュー
        </button>
      </div>
    </div>
    <div class="h-[3px] bg-paper-100/15" aria-hidden="true">
      <div class="h-[3px] bg-kraft w-0" data-read-bar></div>
    </div>
  </header>

  <div class="max-w-site mx-auto md:px-8 md:pb-14 md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-10 md:items-start">
    <div
      id="article-main"
      class="min-w-0"
      data-pagefind-body
      data-pagefind-filter={post.category ? `category:${post.category}` : undefined}
    >
      <span class="hidden" data-pagefind-meta="title">{post.title}</span>
      {post.date && <span class="hidden" data-pagefind-meta="date">{formatDateShort(post.date)}</span>}
      {post.category && <span class="hidden" data-pagefind-meta="category">{post.category}</span>}

      <VHead
        text={vTitle}
        mobile={{ size: hasMemberContent ? 40 : 44, height: hasMemberContent && !post.cover ? 360 : 420, maxWidth: 180, padY: 20, padX: 14, fixed: true }}
        pc={{ size: 56, height: 440, maxWidth: 300, padY: 28, padX: 18, fixed: true }}
        bodyClass="justify-between gap-4 md:!p-7"
      >
        <span class="font-serif font-extrabold text-[13px] md:text-[15px] text-moss tracking-[0.2em]" data-pagefind-ignore>{label}</span>
        {
          hasMemberContent && (
            <span class="chip chip-sumi self-start !px-2.5 !py-1" data-pagefind-ignore>
              旅路の証人 限定
            </span>
          )
        }
        {
          post.cover && (
            <img
              src={post.cover}
              width={coverDim?.width}
              height={coverDim?.height}
              alt=""
              loading="eager"
              class="w-full aspect-[4/5] md:aspect-[16/10] object-cover sepia-img min-h-0"
            />
          )
        }
        <span class="text-[12px] md:text-[13px] leading-[1.7] text-ink-light" data-pagefind-ignore>
          <time datetime={publishedTime}>{formatDate(post.date)}</time>
          <br class="md:hidden" />
          {metaTail && <span class="hidden md:inline"> · </span>}
          {metaTail}
        </span>
      </VHead>

      <div id="article-body" class="relative px-5 pt-1 md:px-0 md:max-w-[680px] md:pt-3">
        <ArticleBody blocks={freeBlocks} />
        {
          hasMemberContent && (
            <div
              id="member-fade"
              class="pointer-events-none absolute left-0 right-0 bottom-0 h-[90px] bg-gradient-to-b from-paper-100/0 to-paper-100"
              aria-hidden="true"
            />
          )
        }
      </div>

      {
        hasMemberContent && (
          <div
            id="member-gate"
            data-slug={post.slug}
            class="mt-2 grid grid-cols-[auto_minmax(0,1fr)] border-y-[3px] border-sumi md:max-w-[680px]"
            data-pagefind-ignore
          >
            <span class="[writing-mode:vertical-rl] font-serif font-extrabold text-[24px] tracking-[0.1em] px-2.5 py-4 bg-moss text-paper-100 border-r-4 border-sumi">
              この先は証人限定
            </span>
            <div class="bg-sumi text-paper-100 p-5 flex flex-col gap-3.5">
              <p class="text-[13px] leading-[1.8] text-onsumi">
                続きには、非常にプライベートで踏み込んだ内容が含まれます。18歳以上の方のみ、4つの条件に同意して読めます。
              </p>
              <a href={joinHref} class="flex items-center justify-center min-h-[48px] bg-paper-100 text-ink hover:bg-kraft hover:text-ink font-serif font-extrabold text-[14px] text-center px-3">
                旅路の証人になって続きを読む
              </a>
              <a href={`${joinHref}#login`} class="flex items-center justify-center min-h-[44px] text-kraft hover:text-paper-100 text-[13px]">
                すでに証人の方はログイン
              </a>
            </div>
          </div>
        )
      }

      {
        hasMemberContent && (
          <!-- Empty at build time -- member-content-body is filled by client-side
               JS only for a logged-in member, after Pagefind has already indexed
               this static HTML, so there is nothing here for it to pick up. The
               ignore attribute is defense-in-depth: it also keeps the gate copy
               above out of every locked article's search snippet. -->
          <div id="member-content" class="hidden px-5 md:px-0 md:max-w-[680px]" data-pagefind-ignore>
            <div id="member-content-skeleton" class="space-y-3 mt-6 animate-pulse" aria-hidden="true">
              <div class="h-4 bg-rule w-full" />
              <div class="h-4 bg-rule w-11/12" />
              <div class="h-4 bg-rule w-full" />
              <div class="h-4 bg-rule w-4/5" />
            </div>
            <div id="member-content-body" class="prose-article" />
          </div>
        )
      }

      {
        post.tags.length > 0 && (
          <div class="px-5 md:px-0 mt-8 md:max-w-[680px]" data-pagefind-ignore>
            <div class="flex flex-wrap gap-2">
              {post.tags.map((tag) => (
                <a href={`/tag/${encodeURIComponent(tag)}/`} class="tag-pill">
                  {tag}
                </a>
              ))}
            </div>
          </div>
        )
      }

      <div class="print-footer hidden">{canonicalUrl}</div>

      <div data-pagefind-ignore class="no-print">
        {
          hasMemberContent ? (
            <div class="mt-8 md:max-w-[680px]">
              {next && (
                <a href={`/posts/${next.slug}/`} class="grid grid-cols-[auto_minmax(0,1fr)] gap-2.5 items-center min-h-[56px] px-5 md:px-2 border-b border-rule text-ink hover:text-ink hover:bg-moss/5">
                  <span class="text-[11px] text-ink-muted">次話 →</span>
                  <span class="font-serif font-extrabold text-[14px] py-2">{displayTitle(next.title, next.series)}</span>
                </a>
              )}
              {prev && (
                <a href={`/posts/${prev.slug}/`} class="grid grid-cols-[auto_minmax(0,1fr)] gap-2.5 items-center min-h-[56px] px-5 md:px-2 border-b border-rule text-ink hover:text-ink hover:bg-moss/5">
                  <span class="text-[11px] text-ink-muted">← 前話</span>
                  <span class="font-serif font-extrabold text-[14px] py-2">{displayTitle(prev.title, prev.series)}</span>
                </a>
              )}
            </div>
          ) : (
            <>
              {next && (
                <NextBlock
                  class="mt-8 md:max-w-[680px]"
                  href={`/posts/${next.slug}/`}
                  title={displayTitle(next.title, next.series)}
                  label={nextLabel}
                  meta={[next.reading_time > 0 ? `約${next.reading_time}分` : "", formatDateShort(next.date)].filter(Boolean).join(" · ")}
                />
              )}
              {prev && (
                <a href={`/posts/${prev.slug}/`} class="grid grid-cols-[auto_minmax(0,1fr)] gap-2.5 items-center min-h-[56px] px-5 md:px-2 border-b border-rule text-ink hover:text-ink hover:bg-moss/5 md:max-w-[680px]">
                  <span class="text-[11px] text-ink-muted">← 前話</span>
                  <span class="font-serif font-extrabold text-[14px] py-2">{displayTitle(prev.title, prev.series)}</span>
                </a>
              )}
            </>
          )
        }

        <EpisodeList post={post} class="md:hidden mx-5 my-6" />

        {
          related.length > 0 && (
            <section class="px-5 md:px-0 mt-10 mb-6 md:max-w-[680px]">
              <h2 class="sec-h">関連記事</h2>
              {related.map((p) => <PostRow post={p} variant="cat" />)}
            </section>
          )
        }
      </div>
    </div>

    <!-- PC sidebar -->
    <aside id="article-side" class="hidden md:flex flex-col gap-5 pt-6 sticky top-20" data-pagefind-ignore>
      <div class="bg-sumi text-paper-100 p-3.5 flex flex-col gap-2.5">
        <span class="text-[11px] tracking-[0.2em] text-rule">
          文字サイズ · 読了 <span class="font-mono text-kraft"><span data-read-pct>0</span>%</span>
        </span>
        <div class="grid grid-cols-3 gap-1" role="group" aria-label="文字サイズ">
          {
            fontSizes.map((z) => (
              <button
                type="button"
                data-fs-btn={z.key}
                aria-label={`文字サイズ ${z.label}`}
                aria-pressed={z.key === "m" ? "true" : "false"}
                class="fs-btn h-11 rounded-[2px] font-serif font-bold"
                style={`font-size:${z.px}px`}
              >
                あ
              </button>
            ))
          }
        </div>
      </div>

      {
        hasToc && (
          <details class="group">
            <summary class="flex items-baseline justify-between pb-2 border-b-[3px] border-moss cursor-pointer list-none">
              <span class="font-serif font-extrabold text-[17px]">目次</span>
              <span class="text-[12px] text-moss group-open:hidden">開く ＋</span>
              <span class="text-[12px] text-moss hidden group-open:inline">閉じる −</span>
            </summary>
            <ol class="max-h-[40vh] overflow-y-auto">
              {toc.map((t) => (
                <li>
                  <a href={`#${t.id}`} class="block py-2 px-2 border-b border-rule text-[13px] leading-[1.5] text-ink hover:text-moss">
                    {t.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <EpisodeList post={post} />

      {
        (prev || next) && (
          <div class="grid grid-cols-2 gap-1.5">
            {prev ? (
              <a href={`/posts/${prev.slug}/`} class="btn btn-outline !text-[13px]">← 前話</a>
            ) : (
              <span class="btn btn-outline !text-[13px] opacity-40" aria-disabled="true">← 前話</span>
            )}
            {next ? (
              <a href={`/posts/${next.slug}/`} class="btn btn-sumi !text-[13px]">次話 →</a>
            ) : (
              <span class="btn btn-sumi !text-[13px] opacity-40" aria-disabled="true">次話 →</span>
            )}
          </div>
        )
      }
    </aside>
  </div>

  <!-- Mobile reading bar: 前話 | あ あ あ | 次話 -->
  <div
    id="reading-bar"
    class="md:hidden fixed left-3 right-3 bottom-3 z-30 grid grid-cols-[48px_minmax(0,1fr)_48px] items-center gap-1.5 p-1.5 bg-sumi text-paper-100 rounded-[4px] border-t-[3px] border-moss"
    data-pagefind-ignore
  >
    <div class="absolute left-0 right-0 -top-[3px] h-[3px]" aria-hidden="true">
      <div class="h-[3px] bg-kraft w-0" data-read-bar></div>
    </div>
    {
      prev ? (
        <a href={`/posts/${prev.slug}/`} class="h-12 flex items-center justify-center text-paper-100 hover:text-kraft font-serif text-[13px]">前話</a>
      ) : (
        <span class="h-12 flex items-center justify-center text-paper-100/30 font-serif text-[13px]" aria-disabled="true">前話</span>
      )
    }
    <div class="flex justify-center gap-1" role="group" aria-label="文字サイズ">
      {
        fontSizes.map((z) => (
          <button
            type="button"
            data-fs-btn={z.key}
            aria-label={`文字サイズ ${z.label}`}
            aria-pressed={z.key === "m" ? "true" : "false"}
            class="fs-btn min-w-[44px] h-10 rounded-[2px] font-serif font-bold"
            style={`font-size:${z.px}px`}
          >
            あ
          </button>
        ))
      }
    </div>
    {
      next ? (
        <a href={`/posts/${next.slug}/`} class="h-12 flex items-center justify-center text-paper-100 hover:text-kraft font-serif text-[13px]">次話</a>
      ) : (
        <span class="h-12 flex items-center justify-center text-paper-100/30 font-serif text-[13px]" aria-disabled="true">次話</span>
      )
    }
  </div>
</Layout>

<style>
  .fs-btn {
    background: rgba(246, 239, 220, 0.1);
    color: #f6efdc;
  }
  .fs-btn[aria-pressed="true"] {
    background: #f4dcb2;
    color: #2a1f11;
  }
  @media (max-width: 767px) {
    :global(body.has-reading-bar footer) {
      padding-bottom: 84px;
    }
  }
</style>

<script define:vars={{ slug: post.slug, series: post.series }}>
  // Reading progress, font size and "already read" bookkeeping.
  (function () {
    var root = document.documentElement;
    var bars = document.querySelectorAll("[data-read-bar]");
    var pcts = document.querySelectorAll("[data-read-pct]");
    var article = document.getElementById("article-main");
    var marked = false;

    function markRead() {
      if (marked) return;
      marked = true;
      try {
        var read = JSON.parse(localStorage.getItem("qn-read") || "[]");
        if (read.indexOf(slug) === -1) {
          read.push(slug);
          if (read.length > 3000) read = read.slice(-3000);
          localStorage.setItem("qn-read", JSON.stringify(read));
        }
        if (series) {
          var last = JSON.parse(localStorage.getItem("qn-last") || "{}");
          last[series] = slug;
          localStorage.setItem("qn-last", JSON.stringify(last));
        }
      } catch (e) {}
    }

    var ticking = false;
    function update() {
      ticking = false;
      if (!article) return;
      var rect = article.getBoundingClientRect();
      var total = article.offsetHeight - window.innerHeight;
      var p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      var pct = Math.round(p * 100);
      bars.forEach(function (b) { b.style.width = pct + "%"; });
      pcts.forEach(function (el) { el.textContent = String(pct); });
      if (pct >= 90 && !document.getElementById("member-gate")?.offsetParent) markRead();
    }
    window.addEventListener("scroll", function () {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    window.addEventListener("resize", update);
    update();

    function setFs(key) {
      if (key === "m") delete root.dataset.fs; else root.dataset.fs = key;
      document.querySelectorAll("[data-fs-btn]").forEach(function (b) {
        b.setAttribute("aria-pressed", b.getAttribute("data-fs-btn") === key ? "true" : "false");
      });
      try { localStorage.setItem("qn-fs", key); } catch (e) {}
      update();
    }
    var initial = root.dataset.fs === "s" || root.dataset.fs === "l" ? root.dataset.fs : "m";
    document.querySelectorAll("[data-fs-btn]").forEach(function (b) {
      b.setAttribute("aria-pressed", b.getAttribute("data-fs-btn") === initial ? "true" : "false");
      b.addEventListener("click", function () { setFs(b.getAttribute("data-fs-btn")); });
    });
  })();
</script>

{hasMemberContent && (
  <script>
    import { createSupabaseBrowserClient } from "../../lib/supabase/browser";

    const gate = document.getElementById("member-gate");
    const content = document.getElementById("member-content");
    const skeleton = document.getElementById("member-content-skeleton");
    const body = document.getElementById("member-content-body");
    const fade = document.getElementById("member-fade");
    const slug = gate?.dataset.slug;

    function showProgress() {
      document.querySelector("[data-gated-label]")?.classList.add("hidden");
      document.querySelectorAll("[data-read-pct], [data-read-pct-unit]").forEach((el) => el.classList.remove("hidden"));
    }

    if (slug) {
      const supabase = createSupabaseBrowserClient();
      supabase.auth.getSession().then(async ({ data: { session } }) => {
        if (!session) return;

        gate?.classList.add("hidden");
        fade?.classList.add("hidden");
        content?.classList.remove("hidden");

        const res = await fetch(`/api/posts/${encodeURIComponent(slug)}/member-content.json`);
        if (!res.ok) {
          content?.classList.add("hidden");
          gate?.classList.remove("hidden");
          fade?.classList.remove("hidden");
          return;
        }

        const { html } = await res.json();
        if (body) body.innerHTML = html;
        skeleton?.remove();
        gate?.remove();
        fade?.remove();
        showProgress();
        window.dispatchEvent(new Event("resize"));
      });
    }
  </script>
)}
