---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import VHead from "../../components/VHead.astro";
import Sidebar from "../../components/Sidebar.astro";
import { getTagIndex } from "../../lib/posts";

const tags = getTagIndex();
const maxCount = Math.max(...tags.map((t) => t.count), 1);
---

<Layout title="タグ一覧" description="テーマタグの一覧。">
  <div class="max-w-site mx-auto md:px-8 md:pb-14 md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-10 md:items-start">
    <div class="min-w-0">
      <VHead
        text="タグ"
        mobile={{ size: 48, height: 200, padY: 18, padX: 14, tracking: 0.15 }}
        pc={{ size: 60, height: 260, padY: 28, padX: 20, tracking: 0.15 }}
        bodyClass="justify-end gap-2.5 md:!p-7"
      >
        <span class="vhead-label">ALL TAGS · {tags.length}</span>
        <span class="vhead-desc">記事数が多いタグほど大きく表示しています。</span>
      </VHead>

      <div class="px-5 md:px-0 pt-5 pb-3 flex flex-wrap gap-1.5">
        {
          tags.map((t, i) => {
            const top = i < 3;
            const px = Math.round(13 + 9 * Math.sqrt(t.count / maxCount));
            return (
              <a
                href={`/tag/${encodeURIComponent(t.name)}/`}
                class={`flex items-baseline gap-1.5 min-h-[44px] px-3 py-2 border font-serif font-extrabold ${
                  top ? "bg-sumi border-sumi text-paper-100 hover:text-kraft" : "border-rule text-ink hover:border-moss hover:text-moss"
                }`}
                style={`font-size:${px}px`}
              >
                {t.name}
                <span class={`font-mono text-[10px] font-normal ${top ? "text-kraft" : "text-ink-muted"}`}>{t.count}</span>
              </a>
            );
          })
        }
      </div>
      <p class="px-5 md:px-0 pb-10 text-[11px] text-ink-muted">記事数上位3つは墨地で強調しています。</p>
    </div>

    <Sidebar latest={6} />
  </div>
</Layout>
