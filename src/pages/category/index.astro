---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import VHead from "../../components/VHead.astro";
import Sidebar from "../../components/Sidebar.astro";
import { getCategoryIndex, categoryAccentHex } from "../../lib/posts";
import { CATEGORY_DESCRIPTIONS, CATEGORY_ORDER } from "../../lib/seriesMeta";

const rank = (n: string) => (CATEGORY_ORDER.indexOf(n) === -1 ? 99 : CATEGORY_ORDER.indexOf(n));
const cats = getCategoryIndex().sort((a, b) => rank(a.name) - rank(b.name) || b.count - a.count);
---

<Layout title="カテゴリ一覧" description="テーマ別に読む。">
  <div class="max-w-site mx-auto md:px-8 md:pb-14 md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-10 md:items-start">
    <div class="min-w-0">
      <VHead
        text="カテゴリ"
        mobile={{ size: 48, height: 240, padY: 18, padX: 14, tracking: 0.12 }}
        pc={{ size: 60, height: 300, padY: 28, padX: 20, tracking: 0.12 }}
        bodyClass="justify-end gap-2.5 md:!p-7"
      >
        <span class="vhead-label">CATEGORIES · {cats.length}</span>
        <span class="vhead-desc">テーマ別に読む。放浪記から入るのがおすすめです。</span>
      </VHead>

      <div class="px-5 md:px-0 pb-10">
        {
          cats.map((c) => (
            <a href={`/category/${encodeURIComponent(c.name)}/`} class="row grid-cols-[6px_minmax(0,1fr)_auto] gap-3.5 !items-stretch py-[18px]">
              <span style={`background:${categoryAccentHex(c.name)}`} />
              <span class="flex flex-col gap-1.5">
                <span class="font-serif font-extrabold text-[19px]">{c.name}</span>
                {CATEGORY_DESCRIPTIONS[c.name] && <span class="text-[13px] leading-[1.7] text-ink-light">{CATEGORY_DESCRIPTIONS[c.name]}</span>}
              </span>
              <span class="flex flex-col items-end gap-0.5">
                <span class="font-serif font-extrabold text-[22px] text-moss leading-tight">{c.count}</span>
                <span class="text-[10px] text-ink-muted">本</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <Sidebar latest={8} />
  </div>
</Layout>
