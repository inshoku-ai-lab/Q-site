---
export const prerender = true;
import type { GetStaticPathsOptions } from "astro";
import Layout from "../../../layouts/Layout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { getCategoryIndex, getPostsByCategory, categoryAccentHex } from "../../../lib/posts";

const catDescriptions: Record<string, string> = {
  "放浪記": "20年以上の世界放浪を綴った自伝的連載。各地での出会いと別れ、日々の断片を残しています。",
  "思想・理論": "デボリューション理論、意識論、覚醒についての考察と検証。",
  "時事・情報戦": "メディアが報じない情報戦争・選挙の真実。",
  "エッセイ・その他": "単発の随筆・観察・雑記。",
  "スピリチュアリティ": "意識、トラウマ、自己と魂の探求。ティール・スワンの解説を中心に。",
  "ビットコインの真実": "真のビットコイン(BSV)、サトシ・ナカモトの正体、暗号通貨を巡る情報戦。",
};

// The largest category (放浪記) holds 500+ posts. Rendering them as one
// page meant 500 image cards in a single document -- slow to parse and
// slow to scroll on a phone even with lazy loading. `paginate` keeps page
// 1 on the original /category/<name>/ URL (so nothing that is already
// linked or indexed breaks) and puts the rest on /category/<name>/2/ etc.
//
// Astro evaluates getStaticPaths in its own scope, so the page size lives
// inside it rather than as a frontmatter const.
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const PAGE_SIZE = 24;
  return getCategoryIndex().flatMap((c) => {
    const posts = getPostsByCategory(c.name).sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));
    return paginate(posts, {
      params: { name: c.name },
      props: { count: c.count },
      pageSize: PAGE_SIZE,
    });
  });
}

const { page, count } = Astro.props;
const name = Astro.params.name as string;
const accentHex = categoryAccentHex(name);

const basePath = `/category/${encodeURIComponent(name)}/`;
const pageLabel = page.lastPage > 1 ? ` (${page.currentPage}/${page.lastPage}ページ)` : "";

// Matches Astro's own paginate() URL convention: page 1 has no numeric
// suffix, page N>1 is `${basePath}${N}/`.
function pageHref(n: number): string {
  return n === 1 ? basePath : `${basePath}${n}/`;
}

// Prev/next alone meant reaching page 21 of 放浪記 took 20 clicks. Build a
// windowed page-number list (first, last, and a few pages either side of
// the current one, with "…" filling any gap) so any page is reachable in
// one click -- the standard pagination pattern for a run this long.
type PageLink = { n: number } | { ellipsis: true };
function buildPageLinks(current: number, last: number): PageLink[] {
  const windowSize = 2;
  const shown = new Set<number>([1, last]);
  for (let n = current - windowSize; n <= current + windowSize; n++) {
    if (n >= 1 && n <= last) shown.add(n);
  }
  const sorted = [...shown].sort((a, b) => a - b);
  const links: PageLink[] = [];
  for (let i = 0; i < sorted.length; i++) {
    if (i > 0 && sorted[i] - sorted[i - 1] > 1) links.push({ ellipsis: true });
    links.push({ n: sorted[i] });
  }
  return links;
}
const pageLinks = page.lastPage > 1 ? buildPageLinks(page.currentPage, page.lastPage) : [];
---

<Layout
  title={`${name} - カテゴリ${pageLabel}`}
  description={`「${name}」カテゴリの全${count}記事。`}
>
  <div class="max-w-page mx-auto px-4 md:px-8 py-16">
    <nav class="mb-6 flex items-center gap-2 text-xs text-ink-muted">
      <a href="/" class="no-underline hover:text-ink">ホーム</a>
      <span class="text-wandering/60">〜</span>
      <a href="/category/" class="no-underline hover:text-ink">カテゴリ</a>
      <span class="text-wandering/60">〜</span>
      <span>{name}</span>
    </nav>

    <header
      class="mb-10 p-8 rounded-lg border max-w-prose"
      style={`background:linear-gradient(135deg, ${accentHex}24, ${accentHex}0a); border-color:${accentHex}33`}
    >
      <h1 class="font-serif text-2xl md:text-4xl font-bold leading-tight" style={`color:${accentHex}`}>{name}</h1>
      {catDescriptions[name] && (
        <p class="mt-3 text-sm text-ink-muted leading-relaxed">{catDescriptions[name]}</p>
      )}
      <p class="mt-3 text-xs font-mono text-ink-muted">
        {count}件の記事{page.lastPage > 1 && ` ・ ${page.currentPage} / ${page.lastPage} ページ`}
      </p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {page.data.map((post) => <ArticleCard post={post} variant="default" showCategory={false} headingLevel="h2" />)}
    </div>

    {page.lastPage > 1 && (
      <nav class="mt-12 flex flex-col items-center gap-4" aria-label="ページ送り">
        <div class="flex flex-wrap items-center justify-center gap-1.5">
          {page.url.prev ? (
            <a
              href={page.url.prev}
              rel="prev"
              aria-label="前のページ"
              class="w-9 h-9 flex items-center justify-center border-[1.5px] border-ink/20 text-ink rounded-full text-sm no-underline hover:bg-moss-dark hover:text-paper-100 hover:border-moss-dark"
            >
              ←
            </a>
          ) : (
            <span class="w-9 h-9" aria-hidden="true"></span>
          )}

          {pageLinks.map((link) =>
            "ellipsis" in link ? (
              <span class="w-9 h-9 flex items-center justify-center text-ink-muted text-sm" aria-hidden="true">
                …
              </span>
            ) : (
              <a
                href={pageHref(link.n)}
                aria-current={link.n === page.currentPage ? "page" : undefined}
                class={`w-9 h-9 flex items-center justify-center rounded-full text-sm no-underline font-mono ${
                  link.n === page.currentPage
                    ? "bg-moss-light text-paper-100"
                    : "border-[1.5px] border-ink/20 text-ink hover:bg-moss-dark hover:text-paper-100 hover:border-moss-dark"
                }`}
              >
                {link.n}
              </a>
            )
          )}

          {page.url.next ? (
            <a
              href={page.url.next}
              rel="next"
              aria-label="次のページ"
              class="w-9 h-9 flex items-center justify-center border-[1.5px] border-ink/20 text-ink rounded-full text-sm no-underline hover:bg-moss-dark hover:text-paper-100 hover:border-moss-dark"
            >
              →
            </a>
          ) : (
            <span class="w-9 h-9" aria-hidden="true"></span>
          )}
        </div>

        <div class="flex items-center gap-4 text-sm">
          <a href={pageHref(1)} class="text-moss no-underline hover:text-moss-dark">最初のページへ</a>
          <span class="text-ink-muted font-mono text-xs">{page.currentPage} / {page.lastPage}</span>
          <a href={pageHref(page.lastPage)} class="text-moss no-underline hover:text-moss-dark">最後のページへ</a>
        </div>
      </nav>
    )}
  </div>
</Layout>
