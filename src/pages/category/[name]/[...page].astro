---
export const prerender = true;
import type { GetStaticPathsOptions } from "astro";
import Layout from "../../../layouts/Layout.astro";
import VHead from "../../../components/VHead.astro";
import PostRow from "../../../components/PostRow.astro";
import Sidebar from "../../../components/Sidebar.astro";
import { getCategoryIndex, getPostsByCategory, categoryAccentHex, formatDateShort } from "../../../lib/posts";
import { CATEGORY_DESCRIPTIONS } from "../../../lib/seriesMeta";

// The largest category (放浪記) holds 500+ posts. Rendering them as one
// page meant 500 image cards in a single document -- slow to parse and
// slow to scroll on a phone even with lazy loading. `paginate` keeps page
// 1 on the original /category/<name>/ URL (so nothing that is already
// linked or indexed breaks) and puts the rest on /category/<name>/2/ etc.
//
// Astro evaluates getStaticPaths in its own scope, so the page size lives
// inside it rather than as a frontmatter const.
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const PAGE_SIZE = 24;
  return getCategoryIndex().flatMap((c) => {
    const posts = getPostsByCategory(c.name).sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));
    return paginate(posts, {
      params: { name: c.name },
      props: { count: c.count },
      pageSize: PAGE_SIZE,
    });
  });
}

const { page, count } = Astro.props;
const name = Astro.params.name as string;
const accentHex = categoryAccentHex(name);
// Page 1 leads with the newest post in a sumi band (15e).
const [lead, ...rest] = page.currentPage === 1 ? page.data : [null, ...page.data];

const basePath = `/category/${encodeURIComponent(name)}/`;
const pageLabel = page.lastPage > 1 ? ` (${page.currentPage}/${page.lastPage}ページ)` : "";

// Matches Astro's own paginate() URL convention: page 1 has no numeric
// suffix, page N>1 is `${basePath}${N}/`.
function pageHref(n: number): string {
  return n === 1 ? basePath : `${basePath}${n}/`;
}

// Prev/next alone meant reaching page 21 of 放浪記 took 20 clicks. Build a
// windowed page-number list (first, last, and a few pages either side of
// the current one, with "…" filling any gap) so any page is reachable in
// one click -- the standard pagination pattern for a run this long.
type PageLink = { n: number } | { ellipsis: true };
function buildPageLinks(current: number, last: number): PageLink[] {
  const windowSize = 1;
  const shown = new Set<number>([1, last]);
  for (let n = current - windowSize; n <= current + windowSize; n++) {
    if (n >= 1 && n <= last) shown.add(n);
  }
  const sorted = [...shown].sort((a, b) => a - b);
  const links: PageLink[] = [];
  for (let i = 0; i < sorted.length; i++) {
    if (i > 0 && sorted[i] - sorted[i - 1] > 1) links.push({ ellipsis: true });
    links.push({ n: sorted[i] });
  }
  return links;
}
const pageLinks = page.lastPage > 1 ? buildPageLinks(page.currentPage, page.lastPage) : [];
---

<Layout
  title={`${name} - カテゴリ${pageLabel}`}
  description={`「${name}」カテゴリの全${count}記事。`}
  back={{ href: "/category/", label: "カテゴリ" }}
>
  <div class="max-w-site mx-auto md:px-8 md:pb-14 md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-10 md:items-start">
    <div class="min-w-0">
      <VHead
        text={name}
        mobile={{ size: 40, height: 260, padY: 18, padX: 12 }}
        pc={{ size: 56, height: 320, maxWidth: 260, padY: 28, padX: 18 }}
        bodyClass="justify-end gap-2.5 md:!p-7"
      >
        <span class="vhead-label flex items-center gap-2">
          <span class="inline-block w-3.5 h-1.5" style={`background:${accentHex}`} />
          CATEGORY · {count}本{page.lastPage > 1 && ` · ${page.currentPage}/${page.lastPage}`}
        </span>
        {CATEGORY_DESCRIPTIONS[name] && <span class="vhead-desc">{CATEGORY_DESCRIPTIONS[name]}</span>}
      </VHead>

      {
        lead && (
          <a href={`/posts/${lead.slug}/`} class="grid grid-cols-[48px_minmax(0,1fr)] border-b border-sumi text-ink hover:text-ink hover:bg-moss/5">
            <span class="[writing-mode:vertical-rl] flex items-center justify-center bg-sumi text-paper-100 font-serif font-extrabold text-[14px] tracking-[0.2em] py-3">
              最新
            </span>
            <span class="flex flex-col gap-1.5 px-5 py-[18px]">
              <span class="font-serif font-extrabold text-[19px] leading-[1.5]">{lead.title}</span>
              <span class="text-[11px] text-ink-muted">
                {formatDateShort(lead.date)}
                {lead.reading_time > 0 && ` · 約${lead.reading_time}分`}
              </span>
            </span>
          </a>
        )
      }

      <div class="px-5 md:px-0">
        {rest.map((post) => post && <PostRow post={post} variant="date" minutes />)}
      </div>

      {
        page.lastPage > 1 && (
          <nav class="px-5 md:px-0 pt-6 pb-10 grid grid-cols-[48px_minmax(0,1fr)_48px] gap-1.5 items-center" aria-label="ページ送り">
            {page.url.prev ? (
              <a href={page.url.prev} rel="prev" aria-label="前のページ" class="h-12 flex items-center justify-center bg-sumi text-paper-100 hover:text-kraft">
                ←
              </a>
            ) : (
              <span class="h-12 flex items-center justify-center border border-rule text-dim" aria-hidden="true">←</span>
            )}
            <div class="flex justify-center gap-1 flex-wrap">
              {pageLinks.map((link) =>
                "ellipsis" in link ? (
                  <span class="min-w-[24px] h-12 flex items-center justify-center text-ink-muted font-mono text-[14px]" aria-hidden="true">
                    …
                  </span>
                ) : (
                  <a
                    href={pageHref(link.n)}
                    aria-current={link.n === page.currentPage ? "page" : undefined}
                    class={`min-w-[40px] h-12 px-1 flex items-center justify-center font-mono text-[14px] ${
                      link.n === page.currentPage ? "bg-moss text-paper-100 hover:text-paper-100" : "text-ink hover:bg-moss/10 hover:text-ink"
                    }`}
                  >
                    {link.n}
                  </a>
                )
              )}
            </div>
            {page.url.next ? (
              <a href={page.url.next} rel="next" aria-label="次のページ" class="h-12 flex items-center justify-center bg-sumi text-paper-100 hover:text-kraft">
                →
              </a>
            ) : (
              <span class="h-12 flex items-center justify-center border border-rule text-dim" aria-hidden="true">→</span>
            )}
          </nav>
        )
      }
      {page.lastPage <= 1 && <div class="pb-10" />}
    </div>

    <Sidebar latest={6} />
  </div>
</Layout>
