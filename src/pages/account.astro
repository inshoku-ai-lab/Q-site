---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import VHead from "../components/VHead.astro";
import PostRow from "../components/PostRow.astro";
import { createSupabaseServerClient } from "../lib/supabase/server";
import { formatDate, getMemberOnlyPosts } from "../lib/posts";

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const {
  data: { user },
} = await supabase.auth.getUser();

let member: { provider: string; joined_at: string } | null = null;
if (user) {
  const { data } = await supabase
    .from("members")
    .select("provider, joined_at")
    .eq("auth_user_id", user.id)
    .maybeSingle();
  member = data;
}

const memberPosts = user && member ? getMemberOnlyPosts(6) : [];

const PROVIDER_LABELS: Record<string, string> = {
  google: "Google",
  facebook: "Facebook",
  line: "LINE",
};
---

<Layout title="アカウント設定" description="旅路の証人アカウントの設定ページです。" noIndex>
  <div class="max-w-site mx-auto md:px-8 md:pb-14">
    <div class="md:max-w-[760px] md:mx-auto">
      {
        !user && (
          <>
            <VHead
              text="アカウント"
              mobile={{ size: 40, height: 260, padY: 18, padX: 12, tracking: 0.1 }}
              pc={{ size: 48, height: 300, padY: 28, padX: 18, tracking: 0.1 }}
              bodyClass="justify-end gap-3 md:!p-7"
            >
              <span class="vhead-label">ACCOUNT</span>
              <span class="vhead-desc">ログインしていません。</span>
              <a href="/join" class="btn btn-sumi">「旅路の証人」になる</a>
              <a href="/join#login" class="btn btn-outline">すでに証人の方はログイン</a>
            </VHead>
            <div class="pb-10" />
          </>
        )
      }

      {
        user && !member && (
          <>
            <VHead
              text="アカウント"
              mobile={{ size: 40, height: 260, padY: 18, padX: 12, tracking: 0.1 }}
              pc={{ size: 48, height: 300, padY: 28, padX: 18, tracking: 0.1 }}
              bodyClass="justify-end gap-3 md:!p-7"
            >
              <span class="vhead-label">ACCOUNT</span>
              <span class="vhead-desc">会員情報が見つかりませんでした。</span>
              <a href="/join" class="btn btn-outline">「旅路の証人」になる</a>
            </VHead>
            <div class="pb-10" />
          </>
        )
      }

      {
        user && member && (
          <>
            <VHead
              text="おかえりなさい"
              mobile={{ size: 40, height: 260, padY: 18, padX: 12, tracking: 0.1 }}
              pc={{ size: 48, height: 300, padY: 28, padX: 18, tracking: 0.1 }}
              bodyClass="justify-end gap-3 md:!p-7"
            >
              <span class="font-serif font-extrabold text-[17px]">旅人さん</span>
              <span class="chip chip-sumi self-start !px-2.5 !py-1">旅路の証人</span>
              <span class="text-[12px] text-ink-muted">{formatDate(member.joined_at)}から</span>
            </VHead>

            {memberPosts.length > 0 && (
              <section class="px-5 md:px-0 pt-6">
                <h2 class="sec-h">会員限定記事</h2>
                {memberPosts.map((p) => <PostRow post={p} variant="cat" />)}
              </section>
            )}

            <section class="px-5 md:px-0 pt-7">
              <h2 class="sec-h">アカウント</h2>
              <div class="flex justify-between gap-3 min-h-[52px] items-center border-b border-rule text-[14px]">
                <span>メールアドレス</span>
                <span class="text-ink-muted text-right break-all">{user.email}</span>
              </div>
              <div class="flex justify-between gap-3 min-h-[52px] items-center border-b border-rule text-[14px]">
                <span>ログイン方法</span>
                <span class="text-ink-muted text-right">{PROVIDER_LABELS[member.provider] ?? member.provider}</span>
              </div>
              <div class="flex justify-between gap-3 min-h-[52px] items-center border-b border-rule text-[14px]">
                <span>「旅路の証人」になった日</span>
                <span class="text-ink-muted text-right">{formatDate(member.joined_at)}</span>
              </div>
              <form method="post" action="/api/auth/logout" class="contents">
                <button
                  type="submit"
                  class="flex w-full justify-between items-center min-h-[52px] border-b border-rule text-[14px] text-ink hover:text-moss text-left"
                >
                  <span>ログアウト</span>
                  <span class="text-ink-muted">→</span>
                </button>
              </form>
            </section>

            <section class="mx-5 md:mx-0 mt-8 mb-10 p-[18px] border border-rust">
              <h2 class="font-serif font-extrabold text-[16px] text-rust">退会する</h2>
              <p class="mt-2 text-[13px] leading-[1.8] text-ink-light">
                退会すると、アカウントと会員情報は即座に完全に削除されます。この操作は元に戻せません。
              </p>
              <button
                id="delete-account-btn"
                type="button"
                class="mt-3 min-h-[44px] px-[18px] border border-rust text-rust text-[13px] font-bold hover:bg-rust hover:text-paper-100 disabled:opacity-50"
              >
                退会する
              </button>
              <p id="delete-error" class="text-[13px] text-rust mt-4 hidden" role="alert" />
            </section>
          </>
        )
      }
    </div>
  </div>
</Layout>

{user && member && (
  <script>
    const btn = document.getElementById("delete-account-btn");
    const errorEl = document.getElementById("delete-error");

    btn?.addEventListener("click", async () => {
      const confirmed = window.confirm("本当に退会しますか？この操作は元に戻せません。");
      if (!confirmed) return;

      btn.setAttribute("disabled", "true");
      const res = await fetch("/api/account/delete", { method: "POST" });

      if (res.ok) {
        window.location.href = "/";
        return;
      }

      btn.removeAttribute("disabled");
      if (errorEl) {
        errorEl.textContent = "退会処理に失敗しました。時間を置いて再度お試しください。";
        errorEl.classList.remove("hidden");
      }
    });
  </script>
)}
