---
// Shared form UI + submission mechanism (honeypot, fill-time check,
// Turnstile, /api/contact) for every contact-style form on the site. Reuse
// this rather than copying the form -- add a new `source` value in
// api/contact.ts (and the migration's check constraint) for a new use, and
// pass copy overrides as props here.
interface Props {
  source: "general" | "silver";
  messageLabel?: string;
  messageHelp?: string;
  messagePlaceholder?: string;
  submitLabel?: string;
  successMessage: string;
}

const {
  source,
  messageLabel = "お問い合わせ内容",
  messageHelp,
  messagePlaceholder,
  submitLabel = "送信する",
  successMessage,
} = Astro.props;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<form id="contact-form" class="space-y-6" data-success-message={successMessage}>
  <div>
    <label for="name" class="block text-sm text-ink mb-1.5">お名前</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      maxlength="100"
      class="w-full border border-paper-300 rounded-md px-4 py-2.5 text-ink bg-paper-50 focus:outline-none focus:border-moss"
    />
  </div>

  <div>
    <label for="email" class="block text-sm text-ink mb-1.5">メールアドレス</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      maxlength="200"
      class="w-full border border-paper-300 rounded-md px-4 py-2.5 text-ink bg-paper-50 focus:outline-none focus:border-moss"
    />
  </div>

  <div>
    <label for="message" class="block text-sm text-ink mb-1.5">{messageLabel}</label>
    {messageHelp && <p class="text-xs text-ink-muted mb-1.5">{messageHelp}</p>}
    <textarea
      id="message"
      name="message"
      required
      maxlength="5000"
      rows="8"
      placeholder={messagePlaceholder}
      class="w-full border border-paper-300 rounded-md px-4 py-2.5 text-ink bg-paper-50 focus:outline-none focus:border-moss resize-y"
    ></textarea>
  </div>

  <input type="hidden" name="source" value={source} />

  <!-- Honeypot field: hidden from real users via CSS, filled by bots. -->
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  {turnstileSiteKey && <div id="turnstile-container" data-sitekey={turnstileSiteKey}></div>}

  <div>
    <button
      type="submit"
      class="px-6 py-3 bg-moss-light text-paper-100 rounded-full font-serif font-extrabold text-sm hover:bg-moss-dark disabled:opacity-40 disabled:cursor-not-allowed transition"
    >
      {submitLabel}
    </button>
  </div>

  <p id="contact-status" class="text-sm mt-2 hidden" role="status"></p>
</form>

<script>
  const pageLoadedAt = Date.now();

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusEl = document.getElementById("contact-status") as HTMLParagraphElement;
  const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const turnstileContainer = document.getElementById("turnstile-container") as HTMLDivElement | null;
  const successMessage = form.dataset.successMessage ?? "送信しました。ありがとうございます。";

  let turnstileWidgetId: string | null = null;

  function loadTurnstileScript(): Promise<void> {
    return new Promise((resolve, reject) => {
      if ((window as any).turnstile) return resolve();
      const s = document.createElement("script");
      s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
      s.async = true;
      s.defer = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error("turnstile script failed to load"));
      document.head.appendChild(s);
    });
  }

  if (turnstileContainer?.dataset.sitekey) {
    loadTurnstileScript()
      .then(() => {
        turnstileWidgetId = (window as any).turnstile.render(turnstileContainer, {
          sitekey: turnstileContainer.dataset.sitekey,
        });
      })
      .catch(() => {
        // If Cloudflare's script fails to load (network issue, blocker),
        // just submit without a token -- the server treats a missing
        // token as a failed verification and returns a clear error.
      });
  }

  const ERROR_MESSAGES: Record<string, string> = {
    rate_limited: "短時間に送信が集中しています。しばらく時間を置いてから再度お試しください。",
    verification_failed: "スパム確認に失敗しました。ページを再読み込みしてからもう一度お試しください。",
    missing_fields: "すべての項目を入力してください。",
    invalid_email: "メールアドレスの形式が正しくありません。",
    too_long: "入力内容が長すぎます。",
  };

  function showStatus(message: string, isError: boolean) {
    statusEl.textContent = message;
    statusEl.classList.remove("hidden", "text-rust", "text-moss-dark");
    statusEl.classList.add(isError ? "text-rust" : "text-moss-dark");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get("name") ?? "").trim(),
      email: String(formData.get("email") ?? "").trim(),
      message: String(formData.get("message") ?? "").trim(),
      source: String(formData.get("source") ?? "general"),
      website: String(formData.get("website") ?? ""),
      elapsedMs: Date.now() - pageLoadedAt,
      turnstileToken:
        turnstileWidgetId !== null ? (window as any).turnstile?.getResponse(turnstileWidgetId) ?? "" : "",
    };

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        showStatus(successMessage, false);
        form.reset();
      } else {
        const data = await res.json().catch(() => ({}));
        showStatus(ERROR_MESSAGES[data.error] ?? "送信に失敗しました。時間を置いて再度お試しください。", true);
        submitBtn.disabled = false;
        if (turnstileWidgetId !== null) (window as any).turnstile?.reset(turnstileWidgetId);
      }
    } catch {
      showStatus("送信に失敗しました。時間を置いて再度お試しください。", true);
      submitBtn.disabled = false;
    }
  });
</script>
