---
// PC sidebar (12b): 連載 rows + 最新の記事.
import { getLatestPosts } from "../lib/posts";
import { getSeriesSorted, SERIES_DESCRIPTIONS, seriesHref } from "../lib/seriesMeta";
import PostRow from "./PostRow.astro";

interface Props {
  latest?: number;
  series?: boolean;
  exclude?: string;
  seriesTitle?: string;
}
const { latest = 6, series = true, exclude, seriesTitle = "連載" } = Astro.props;
const seriesList = getSeriesSorted().filter((s) => s.name !== exclude).slice(0, 6);
const latestPosts = getLatestPosts(latest);
---

<aside class="hidden md:flex flex-col gap-8 pt-7">
  <slot />
  {
    series && (
      <div>
        <h2 class="sec-h">{seriesTitle}</h2>
        {seriesList.map((s) => (
          <a href={seriesHref(s.name)} class="row grid-cols-[6px_minmax(0,1fr)_auto] gap-3 !items-stretch py-3.5">
            <span class="bg-sumi" />
            <span class="flex flex-col gap-1">
              <span class="font-serif font-extrabold text-[16px]">{s.name}</span>
              {SERIES_DESCRIPTIONS[s.name] && <span class="text-[12px] leading-[1.6] text-ink-light">{SERIES_DESCRIPTIONS[s.name]}</span>}
            </span>
            <span class="font-mono text-[12px] text-moss">{s.count}</span>
          </a>
        ))}
      </div>
    )
  }
  {
    latest > 0 && (
      <div>
        <h2 class="sec-h">最新の記事</h2>
        {latestPosts.map((p) => <PostRow post={p} variant="stack" />)}
        <a href="/archive/" class="flex items-center justify-end min-h-[44px] text-[12px] font-bold">すべての記事 →</a>
      </div>
    )
  }
</aside>
