---
// Site header (sumi band).
//   variant "masthead": the top page's two-line title with date / 第N号
//   variant "default":  one-line title, or a "← 親ページ" link on mobile
// The menu itself (15a) lives in SiteMenu.astro and opens from any
// [data-menu-open] button.
import { getPublishedPosts } from "../lib/posts";
import { mastheadDate } from "../lib/verticalText";

interface Props {
  variant?: "masthead" | "default";
  back?: { href: string; label: string };
}
const { variant = "default", back } = Astro.props;

const pathname = decodeURI(Astro.url.pathname);

const issue = getPublishedPosts().length;
const today = mastheadDate();

const nav = [
  { path: "/series/放浪記/", label: "放浪記" },
  { path: "/category/思想・理論/", label: "思想・理論" },
  { path: "/category/時事・情報戦/", label: "時事・情報戦" },
  { path: "/series/", label: "連載一覧" },
];
const activePath = nav.find((n) => n.path !== "/series/" && pathname.startsWith(n.path))?.path ?? (pathname === "/series/" ? "/series/" : null);
---

<header id="site-header" class="bg-sumi text-paper-100">
  <div
    class={`max-w-site mx-auto flex items-center justify-between gap-4 pl-5 pr-2 md:px-8 ${
      variant === "masthead" ? "py-3.5 md:py-[18px]" : "min-h-[52px] md:min-h-[60px]"
    }`}
  >
    {
      back && (
        <a href={back.href} class="md:hidden text-[12px] text-rule hover:text-paper-100 min-h-[44px] inline-flex items-center">
          ← {back.label}
        </a>
      )
    }
    <a
      href="/"
      class={`font-serif font-extrabold text-paper-100 hover:text-paper-100 leading-[1.1] ${back ? "hidden md:inline" : ""} ${
        variant === "masthead" ? "text-[20px] md:text-[26px]" : "text-[16px] md:text-[22px]"
      }`}
    >
      {
        variant === "masthead" ? (
          <>
            Qryptraveller's<br class="md:hidden" /> Notes
          </>
        ) : (
          "Qryptraveller's Notes"
        )
      }
    </a>

    <nav class="hidden md:flex items-center gap-7 text-[14px] font-bold ml-auto" aria-label="主要カテゴリ">
      {
        nav.map((n) => (
          <a
            href={encodeURI(n.path)}
            aria-current={activePath === n.path ? "page" : undefined}
            class={activePath === n.path ? "text-kraft hover:text-kraft" : "text-paper-100 hover:text-kraft"}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 md:gap-5">
      {
        variant === "masthead" && (
          <div class="text-right text-[10px] md:text-[11px] leading-[1.6] text-rule">
            {today}
            <br />
            第{issue}号
          </div>
        )
      }
      <button
        type="button"
        data-menu-open
        class="min-h-[44px] min-w-[44px] px-3 md:px-0 text-[13px] md:text-[14px] font-bold text-paper-100 hover:text-kraft"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        メニュー
      </button>
    </div>
  </div>
</header>
