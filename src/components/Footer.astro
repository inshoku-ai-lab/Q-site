---
const year = new Date().getFullYear();

const links = [
  { href: "/series/", label: "連載一覧" },
  { href: "/category/", label: "カテゴリ" },
  { href: "/tag/", label: "タグ" },
  { href: "/archive/", label: "アーカイブ" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "お問い合わせ" },
  { href: "/privacy/", label: "プライバシー" },
  { href: "/terms/", label: "利用規約" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="bg-foot border-t-[6px] border-moss text-paper-100">
  <div class="max-w-site mx-auto px-5 md:px-8 pt-6 pb-10 md:py-10 md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-10">
    <div>
      <div class="font-serif font-extrabold text-[18px]">Qryptraveller's Notes</div>
      <p class="mt-2 text-[13px] leading-[1.8] text-onsumi">地球放浪20年以上の旅人による、旅と思索の記録。</p>
    </div>
    <div>
      <ul class="mt-5 md:mt-0 flex flex-wrap gap-x-4 gap-y-1 text-[12px]">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="text-rule hover:text-kraft inline-flex items-center min-h-[32px]">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-[11px] text-dim">
        © {year} Qryptraveller · <span class="font-serif italic">"Travel light, observe deeply."</span>
      </p>
    </div>
  </div>
</footer>
