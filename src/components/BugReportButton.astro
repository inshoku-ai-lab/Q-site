---
// Global bug-report widget -- included once in Layout.astro so it floats
// over every page.
---

<button
  type="button"
  id="bug-report-fab"
  aria-label="不具合を報告する"
  class="group fixed bottom-4 right-4 z-40 w-12 h-12 flex items-center justify-center bg-sumi text-paper-100 hover:bg-[#3a2c19] transition-colors"
>
  <!-- Line-drawn bug (Lucide "bug", ISC licence) -->
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m8 2 1.88 1.88" />
    <path d="M14.12 3.88 16 2" />
    <path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1" />
    <path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6" />
    <path d="M12 20v-9" />
    <path d="M6.53 9C4.6 8.8 3 7.1 3 5" />
    <path d="M6 13H2" />
    <path d="M3 21c0-2.1 1.7-3.9 3.8-4" />
    <path d="M20.97 5c0 2.1-1.6 3.8-3.5 4" />
    <path d="M22 13h-4" />
    <path d="M17.2 17c2.1.1 3.8 1.9 3.8 4" />
  </svg>
  <!-- Label slides in on hover / keyboard focus -->
  <span
    class="pointer-events-none absolute right-full mr-2 top-1/2 -translate-y-1/2 translate-x-1 whitespace-nowrap bg-sumi text-paper-100 text-[12px] font-bold px-3 py-2 opacity-0 transition-all duration-150 group-hover:opacity-100 group-hover:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:translate-x-0"
    aria-hidden="true"
    id="bug-report-fab-label"
  >
    不具合を報告
  </span>
</button>

<style is:global>
  .bug-cat:has(:checked) {
    background: #2a1f11;
    border-color: #2a1f11;
    color: #f6efdc;
  }
  .bug-cat:has(:focus-visible) {
    outline: 2px solid #4f6b43;
    outline-offset: 2px;
  }
  /* Article pages carry a fixed reading bar along the bottom on mobile. */
  @media (max-width: 767px) {
    body.has-reading-bar #bug-report-fab {
      bottom: 84px;
    }
  }
</style>

<div id="bug-report-overlay" class="fixed inset-0 z-50 bg-sumi/60 hidden items-center justify-center p-4">
  <div
    class="bg-paper-100 border-t-[6px] border-moss w-full max-w-md max-h-[90vh] overflow-y-auto p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="bug-report-title"
  >
    <div class="flex items-center justify-between mb-4">
      <h2 id="bug-report-title" class="font-serif text-lg font-extrabold text-ink">不具合を報告する</h2>
      <button type="button" id="bug-report-close" aria-label="閉じる" class="min-w-[44px] min-h-[44px] -mr-3 text-ink-muted hover:text-ink text-xl leading-none">×</button>
    </div>

    <form id="bug-report-form" class="space-y-4">
      <p id="bug-report-context" class="hidden px-3 py-2 border-l-4 border-moss bg-done text-[12px] leading-[1.7] text-ink"></p>

      <fieldset>
        <legend class="block text-sm text-ink mb-1.5">どんな問題ですか？</legend>
        <div class="flex flex-wrap gap-1.5" id="bug-report-categories">
          {
            ["表示が崩れた", "記事が読めない", "ログインできない", "誤字・内容の間違い", "その他"].map((c) => (
              <label class="bug-cat flex items-center min-h-[40px] px-3 border border-rule bg-field text-[13px] text-ink cursor-pointer">
                <input type="radio" name="category" value={c} class="sr-only" />
                {c}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div>
        <label for="bug-description" class="block text-sm text-ink mb-1.5">何が起きましたか？</label>
        <textarea
          id="bug-description"
          name="description"
          required
          maxlength="3000"
          rows="5"
          placeholder="どのページで、何をしたときに、何が起きたかを教えてください"
          class="field !text-[15px]"
        ></textarea>
      </div>

      <div>
        <label for="bug-email" class="block text-sm text-ink mb-1.5">メールアドレス(任意・返信が必要な場合)</label>
        <input
          type="email"
          id="bug-email"
          name="email"
          maxlength="200"
          class="field !text-[15px]"
        />
      </div>

      <p id="bug-report-env-summary" class="text-[11px] text-ink-muted leading-relaxed"></p>

      <!-- Honeypot -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="bug-website">Website</label>
        <input type="text" id="bug-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="flex items-center gap-3">
        <button
          type="submit"
          class="btn btn-sumi border-t-[3px] !border-t-moss"
        >
          送信する
        </button>
        <p id="bug-report-status" class="text-sm hidden" role="status"></p>
      </div>
    </form>

    <!-- Shown instead of the form after a successful send -->
    <div id="bug-report-done" class="hidden" role="status">
      <p class="font-serif font-extrabold text-[17px] text-ink">報告を受け付けました。ありがとうございます。</p>
      <p class="mt-3 text-[13px] leading-[1.8] text-ink-light">
        受付番号 <span id="bug-report-ref" class="font-mono font-bold text-ink text-[15px]"></span>
      </p>
      <p class="mt-2 text-[12px] leading-[1.8] text-ink-muted">
        お問い合わせの際に、この番号をお伝えいただくと確認が早くなります。
      </p>
      <button type="button" id="bug-report-done-close" class="btn btn-sumi border-t-[3px] !border-t-moss mt-5">閉じる</button>
    </div>
  </div>
</div>

<script>
  import { parseUserAgent } from "../lib/userAgent";

  const pageLoadedAt = Date.now();

  const fab = document.getElementById("bug-report-fab") as HTMLButtonElement;
  const overlay = document.getElementById("bug-report-overlay") as HTMLDivElement;
  const closeBtn = document.getElementById("bug-report-close") as HTMLButtonElement;
  const form = document.getElementById("bug-report-form") as HTMLFormElement;
  const statusEl = document.getElementById("bug-report-status") as HTMLParagraphElement;
  const envSummaryEl = document.getElementById("bug-report-env-summary") as HTMLParagraphElement;
  const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const contextEl = document.getElementById("bug-report-context") as HTMLParagraphElement;
  const doneEl = document.getElementById("bug-report-done") as HTMLDivElement;
  const refEl = document.getElementById("bug-report-ref") as HTMLSpanElement;
  const fabLabel = document.getElementById("bug-report-fab-label") as HTMLSpanElement | null;

  // On an article page the report is about that article: name it in the
  // dialog and send its title along; the usual case there is a typo.
  const articleTitle = window.location.pathname.startsWith("/posts/")
    ? document.title.replace(/\s*\|\s*Qryptraveller.*$/, "").trim()
    : "";
  if (articleTitle) {
    if (fabLabel) fabLabel.textContent = "誤字・不具合を報告";
    fab.setAttribute("aria-label", "誤字・不具合を報告する");
  }

  const ua = parseUserAgent(navigator.userAgent);
  const deviceLabel = { mobile: "スマートフォン", tablet: "タブレット", desktop: "パソコン" }[ua.deviceType];
  envSummaryEl.textContent = `自動で送信される情報: ${deviceLabel} / ${ua.browser} / ${ua.os} / このページのURL`;

  // Remembered so focus can be handed back where it came from on close,
  // instead of being dropped at the top of the document.
  let lastFocused: HTMLElement | null = null;

  function openModal() {
    lastFocused = document.activeElement as HTMLElement | null;
    form.classList.remove("hidden");
    doneEl.classList.add("hidden");
    if (articleTitle) {
      contextEl.textContent = `この記事についての報告になります：${articleTitle}`;
      contextEl.classList.remove("hidden");
      const typo = form.querySelector<HTMLInputElement>('input[name="category"][value="誤字・内容の間違い"]');
      if (typo && !form.querySelector('input[name="category"]:checked')) typo.checked = true;
    } else {
      contextEl.classList.add("hidden");
    }
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    document.getElementById("bug-description")?.focus();
  }
  function closeModal() {
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    lastFocused?.focus();
  }

  fab.addEventListener("click", openModal);
  closeBtn.addEventListener("click", closeModal);
  document.getElementById("bug-report-done-close")?.addEventListener("click", closeModal);
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !overlay.classList.contains("hidden")) closeModal();
  });

  function showStatus(message: string, isError: boolean) {
    statusEl.textContent = message;
    statusEl.classList.remove("hidden", "text-rust", "text-moss-dark");
    statusEl.classList.add(isError ? "text-rust" : "text-moss-dark");
  }

  const ERROR_MESSAGES: Record<string, string> = {
    rate_limited: "短時間に送信が集中しています。しばらく時間を置いてから再度お試しください。",
    missing_fields: "内容を入力してください。",
    too_long: "入力内容が長すぎます。",
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;

    const formData = new FormData(form);
    const payload = {
      description: String(formData.get("description") ?? "").trim(),
      category: String(formData.get("category") ?? ""),
      articleTitle,
      email: String(formData.get("email") ?? "").trim(),
      website: String(formData.get("website") ?? ""),
      elapsedMs: Date.now() - pageLoadedAt,
      pageUrl: window.location.href,
      deviceType: ua.deviceType,
      browser: ua.browser,
      os: ua.os,
      userAgent: navigator.userAgent,
      viewportWidth: window.innerWidth,
      viewportHeight: window.innerHeight,
    };

    try {
      const res = await fetch("/api/bug-report", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        const data = await res.json().catch(() => ({}));
        form.reset();
        statusEl.classList.add("hidden");
        submitBtn.disabled = false;
        refEl.textContent = typeof data.ref === "string" ? data.ref : "";
        refEl.parentElement?.classList.toggle("hidden", !data.ref);
        form.classList.add("hidden");
        doneEl.classList.remove("hidden");
        document.getElementById("bug-report-done-close")?.focus();
      } else {
        const data = await res.json().catch(() => ({}));
        showStatus(ERROR_MESSAGES[data.error] ?? "送信に失敗しました。時間を置いて再度お試しください。", true);
        submitBtn.disabled = false;
      }
    } catch {
      showStatus("送信に失敗しました。時間を置いて再度お試しください。", true);
      submitBtn.disabled = false;
    }
  });
</script>
