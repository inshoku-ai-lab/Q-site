---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteMenu from "../components/SiteMenu.astro";
import BugReportButton from "../components/BugReportButton.astro";
import { metaCspValue } from "../lib/csp";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  articleSection?: string;
  noIndex?: boolean;
  bodyClass?: string;
  structuredData?: Record<string, unknown>;
  // "none": the page renders its own header (article pages)
  header?: "masthead" | "default" | "none";
  back?: { href: string; label: string };
  // Pages with the fixed mobile reading bar need room under the footer.
  readingBar?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType = "website",
  publishedTime,
  articleSection,
  noIndex,
  bodyClass = "",
  structuredData,
  header = "default",
  back,
  readingBar = false,
} = Astro.props;
const siteName = "Qryptraveller's Notes";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const defaultDesc =
  "地球放浪２０年以上の旅人クリプトラベラーによる、旅の記録と思索のアーカイブ。放浪記、思想・理論、時事考察、エッセイ。";
const desc = description ?? defaultDesc;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://qryptraveller.com").toString();
const absoluteOgImage = ogImage
  ? new URL(ogImage, Astro.site ?? "https://qryptraveller.com").toString()
  : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Statically prerendered pages are served straight from the CDN and
         never pass through src/middleware.ts, so the policy is carried in
         the document itself. On-demand routes additionally get it (plus
         frame-ancestors) as a real header. -->
    <meta http-equiv="Content-Security-Policy" content={metaCspValue()} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    {!noIndex && <meta name="robots" content="index,follow,max-image-preview:large" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {absoluteOgImage && <meta property="og:image:width" content="1200" />}
    {absoluteOgImage && <meta property="og:image:height" content="630" />}
    {absoluteOgImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && articleSection && <meta property="article:section" content={articleSection} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2A1F11" />
    <!-- Apply the remembered reading size before first paint. -->
    <script is:inline>
      try {
        var fs = localStorage.getItem("qn-fs");
        if (fs === "s" || fs === "l") document.documentElement.dataset.fs = fs;
      } catch (e) {}
    </script>

    <!-- Fonts: fetched as a non-blocking stylesheet (loaded as `preload`,
         then flipped to `stylesheet` once it arrives) so a slow response
         from Google delays the webfonts, not first paint. The system font
         stack in tailwind.config.mjs covers the gap. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      />
    </noscript>

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>

  <body class={`min-h-screen flex flex-col bg-paper-100 text-ink ${readingBar ? "has-reading-bar" : ""} ${bodyClass}`}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2 focus:bg-moss-dark focus:text-paper-100"
    >
      本文へスキップ
    </a>
    {header !== "none" && <Header variant={header} back={back} />}
    <slot name="header" />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <SiteMenu />
    <BugReportButton />
  </body>
</html>
